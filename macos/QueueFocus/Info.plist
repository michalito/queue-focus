<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A windowless menu bar app would be napped, and its one-second tick
	     writes the settings and keeps the reminder's schedule. -->
	<key>NSAppSleepDisabled</key>
	<true/>
	<!-- queuefocus: links, to add a task or open a view (see AppURL). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.queuefocus.QueueFocus</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>queuefocus</string>
			</array>
		</dict>
	</array>
	<!-- What a dragged task is, inside the app only. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.queuefocus.task-id</string>
			<key>UTTypeDescription</key>
			<string>Queue Focus task</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
