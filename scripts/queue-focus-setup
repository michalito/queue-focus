#!/usr/bin/env bash
# Per-user setup for queue-focus.
#
#   queue-focus-setup                 enable the top-bar extension (it also provides the
#                                     global shortcuts; log out/in once on Wayland)
#   queue-focus-setup enable --allow-user-extensions
#                                     also clear GNOME's global extension safety switch
#   queue-focus-setup keys            show the current shortcuts
#   queue-focus-setup key NAME KEY    change one, e.g.  key toggle-queue '<Super>space'
#                                     names: toggle-queue quick-add show-board complete-current
#   queue-focus-setup disable         disable the extension
set -euo pipefail

UUID="queue-focus@queuefocus.org"
SCHEMA="org.gnome.shell.extensions.queue-focus"
KEYS=(toggle-queue quick-add show-board complete-current)

ext_dir() {
  for d in "$HOME/.local/share/gnome-shell/extensions/$UUID" "/usr/share/gnome-shell/extensions/$UUID"; do
    [ -d "$d" ] && { echo "$d"; return; }
  done
  return 1
}

gs() { gsettings --schemadir "$(ext_dir)/schemas" "$@"; }

case "${1:-enable}" in
  enable)
    [ $# -le 2 ] && { [ $# -lt 2 ] || [ "$2" = "--allow-user-extensions" ]; } || {
      echo "usage: queue-focus-setup enable [--allow-user-extensions]" >&2
      exit 2
    }
    dir=$(ext_dir) || { echo "extension not installed (run 'make install' or install the .deb)" >&2; exit 1; }
    [ -f "$dir/schemas/gschemas.compiled" ] || glib-compile-schemas "$dir/schemas"
    if [ "$(gsettings get org.gnome.shell disable-user-extensions)" = "true" ]; then
      if [ "${2:-}" != "--allow-user-extensions" ]; then
        echo "GNOME's global extension safety switch is active; it was left unchanged." >&2
        echo "To explicitly re-enable all enabled user extensions, run:" >&2
        echo "  queue-focus-setup enable --allow-user-extensions" >&2
        exit 1
      fi
      gsettings set org.gnome.shell disable-user-extensions false
    fi
    if gnome-extensions info "$UUID" >/dev/null 2>&1; then
      gnome-extensions enable "$UUID"
      echo "extension enabled"
    else
      # The running shell only scans extension dirs at login; enable via gsettings.
      cur=$(gsettings get org.gnome.shell enabled-extensions)
      if [[ "$cur" != *"'$UUID'"* ]]; then
        [ "$cur" = "@as []" ] && new="['$UUID']" || new="${cur%]}, '$UUID']"
        gsettings set org.gnome.shell enabled-extensions "$new"
      fi
      echo "extension enabled — log out and back in for it to load"
    fi
    "$0" keys
    ;;
  keys)
    for k in "${KEYS[@]}"; do printf '  %-18s %s\n' "$k" "$(gs get "$SCHEMA" "$k")"; done
    echo "change with: queue-focus-setup key NAME '<Super>x'"
    ;;
  key)
    [ $# -eq 3 ] || { echo "usage: queue-focus-setup key NAME KEY" >&2; exit 2; }
    gs set "$SCHEMA" "$2" "['$3']"
    "$0" keys
    ;;
  disable)
    gnome-extensions disable "$UUID" 2>/dev/null || true
    cur=$(gsettings get org.gnome.shell enabled-extensions)
    new=$(python3 -c "import ast,sys; l=ast.literal_eval(sys.argv[1]); l=[x for x in l if x!=sys.argv[2]]; print(l if l else '@as []')" "${cur#@as }" "$UUID")
    gsettings set org.gnome.shell enabled-extensions "$new"
    echo "extension disabled"
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
